# Layer-mode fixture: exercises the customer-facing layer entrypoint
# /opt/nodejs/node_modules/datadog-lambda-js/handler.handler instead of the
# npm-installed dist/handler.handler path. The layer tree (layer_pkg/) and the
# dependency manifest (deps.package.json) are generated by
# integration_tests_local/run.sh from the repo build, mirroring the release
# Dockerfile's layer layout:
#   dist/ contents  -> /opt/nodejs/node_modules/datadog-lambda-js/
#   src/handler.mjs -> .../datadog-lambda-js/handler.mjs
#   src/runtime/module_importer.js -> .../datadog-lambda-js/runtime/ (overlay)
#   production deps + dd-trace -> /opt/nodejs/node_modules/
ARG NODE_VERSION=22
FROM public.ecr.aws/lambda/nodejs:${NODE_VERSION}

# Install dependencies BEFORE copying layer_pkg: npm prunes anything in
# node_modules that is not in deps.package.json, so copying the layer tree
# first would silently delete it.
COPY deps.package.json /opt/nodejs/package.json
# --omit=optional matches the release build's --ignore-optional: pprof/appsec
# natives are not exercised by these fixtures and skipping them keeps the
# build fast.
RUN cd /opt/nodejs && npm install --omit=dev --omit=optional --no-audit --no-fund
COPY layer_pkg /opt/nodejs/node_modules/datadog-lambda-js/

# handler.js (CJS) and esm.mjs (top-level await) are plain unwrapped user
# handlers; the layer's handler.mjs wraps them via DD_LAMBDA_HANDLER.
COPY handler.js esm.mjs ${LAMBDA_TASK_ROOT}/

CMD ["/opt/nodejs/node_modules/datadog-lambda-js/handler.handler"]
